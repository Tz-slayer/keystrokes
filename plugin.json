{
    "id": "keystrokes",
    "name": "Keystrokes",
    "icon": "keyboard",
    "description": "Keystroke and mouse overlay for DankMaterialShell, ported from keyviz, for screencasts and tutorials",
    "version": "1.3.0",
    "author": "tz-slayer",
    "type": "composite",
    "capabilities": [
        "daemon",
        "control-center"
    ],
    "components": {
        "daemon": "./Daemon.qml",
        "widget": "./Widget.qml"
    },
    "settings": "./Settings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "shell_execute"
    ]
}
