{
    "id": "keystrokes",
    "name": "Keystrokes",
    "icon": "keyboard",
    "description": "Displays keystrokes and mouse actions on screen, with keyviz's animations and keycaps, for screencasts and tutorials",
    "version": "1.2.0",
    "author": "hthienloc",
    "type": "composite",
    "capabilities": [
        "daemon",
        "control-center"
    ],
    "components": {
        "daemon": "./KeyvizDaemon.qml",
        "widget": "./KeyvizWidget.qml"
    },
    "settings": "./KeyvizSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "shell_execute"
    ]
}
