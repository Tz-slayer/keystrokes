{
    "id": "keyviz",
    "name": "Keyviz",
    "icon": "keyboard",
    "description": "Displays keystrokes on screen with keyviz-style animations, for tutorials",
    "version": "1.2.0",
    "author": "Loc Huynh",
    "type": "composite",
    "capabilities": [
        "daemon",
        "control-center"
    ],
    "components": {
        "daemon": "./KeyvizDaemon.qml",
        "widget": "./KeyvizWidget.qml"
    },
    "settings": "./KeyvizSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "shell_execute"
    ]
}
